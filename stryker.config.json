{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "config.mjs",
    "compose.mjs",
    "voice.mjs",
    "record.mjs"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mjs"
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "concurrency": 2,
  "timeoutMS": 20000,
  "coverageAnalysis": "off"
}
